{
	// Open this file in VS Code (double-click it, or File -> Open Workspace
	// from File...) to get the Run Tasks and recommended extensions.
	// It lives in the project root, so it works wherever the repo is cloned.
	"folders": [
		{
			"name": "chubb-claims-platform",
			"path": "."
		}
	],
	"settings": {
		"java.configuration.updateBuildConfiguration": "automatic",
		"files.exclude": {
			"**/.angular": true,
			"**/target": true
		},
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/.angular/**": true,
			"**/target/**": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/.angular": true,
			"**/target": true,
			"**/package-lock.json": true
		},
		"java.compile.nullAnalysis.mode": "automatic"
	},
	"extensions": {
		"recommendations": [
			"vscjava.vscode-java-pack",
			"vmware.vscode-boot-dev-pack",
			"angular.ng-template"
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Start backend",
				"type": "shell",
				"command": "mvn spring-boot:run",
				"options": { "cwd": "${workspaceFolder}/backend" },
				"isBackground": true,
				"problemMatcher": []
			},
			{
				"label": "Start backend (with Kafka)",
				"type": "shell",
				"command": "mvn spring-boot:run",
				"options": {
					"cwd": "${workspaceFolder}/backend",
					"env": { "KAFKA_ENABLED": "true" }
				},
				"isBackground": true,
				"problemMatcher": []
			},
			{
				"label": "Install frontend dependencies",
				"type": "shell",
				"command": "npm install",
				"options": { "cwd": "${workspaceFolder}/frontend" },
				"problemMatcher": []
			},
			{
				"label": "Start frontend",
				"type": "shell",
				"command": "npm start",
				"options": { "cwd": "${workspaceFolder}/frontend" },
				"isBackground": true,
				"problemMatcher": []
			},
			{
				"label": "Start Kafka (Docker)",
				"type": "shell",
				"command": "docker compose up -d",
				"options": { "cwd": "${workspaceFolder}" },
				"problemMatcher": []
			},
			{
				"label": "Run backend tests",
				"type": "shell",
				"command": "mvn test",
				"options": { "cwd": "${workspaceFolder}/backend" },
				"group": "test",
				"problemMatcher": []
			}
		]
	}
}
